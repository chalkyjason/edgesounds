# Normalize line endings for text; preserve binaries
* text=auto eol=lf

# .mcm fonts are ASCII and MUST stay LF. A CRLF checkout produces a file
# Betaflight Configurator will not parse, so never let git rewrite them.
*.mcm   text eol=lf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.bmp   binary

# Keep Windows-only scripts CRLF
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
