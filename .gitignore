# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Build output that is regenerated by tools/build_font.py.
# Released .mcm files under fonts/ ARE committed -- they are the deliverable.
build/
*.mcm.tmp

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.sw?

# Web app (web/)
web/node_modules/
web/dist/
# ffmpeg.wasm runtime assets (regenerated by web/scripts/sync-ffmpeg.mjs on postinstall)
web/public/ffmpeg/
# OSD assets staged from ../fonts and ../previews at build time
web/public/osd/

# Playwright MCP scratch output — screenshots and page snapshots
.playwright-mcp/
web/.playwright-mcp/
